# ─── Client-exposed (VITE_*) ───────────────────────────────────────
# URL your site serves the desktop ad creative from. It is loaded
# inside a sandboxed <webview>. Leave empty to show the placeholder.
VITE_AD_URL=

# Where the "Go Ad-Free / Upgrade" button sends users.
VITE_LICENSE_URL=https://your-site.example/upgrade

# Ed25519 public key (SPKI PEM) for license token verification.
# Generate with: node scripts/generate-license-keys.mjs
LICENSE_PUBLIC_KEY=

# ─── Server / tooling only (NOT exposed to the client) ──────────
# Ed25519 private key (PKCS8 PEM) for signing license tokens.
# Keep this secret. Used by scripts/issue-license.mjs.
LICENSE_PRIVATE_KEY=
